[Unit]
Description=Poll Japan incident feeds and publish static data
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=30min
StartLimitBurst=4

[Service]
Type=oneshot
User=jp-incidents
Group=jp-incidents
WorkingDirectory=/opt/jp-incidents
Environment=HOME=/var/lib/jp-incidents
Environment=JPI_DB=/opt/jp-incidents/jp_incidents.db
Environment=JPI_JSON_PATH=/opt/jp-incidents/data/incidents.json
Environment=JPI_RSS_PATH=/opt/jp-incidents/feed.xml
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/jp-incidents/.env
ExecStart=/usr/bin/python3 /opt/jp-incidents/jp_incidents.py poll --notify --publish
Restart=on-failure
RestartSec=5min
