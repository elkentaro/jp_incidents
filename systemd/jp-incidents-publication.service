[Unit]
Description=Retry pending JP Incident Monitor publication
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=jp-incidents
Group=jp-incidents
WorkingDirectory=/opt/jp-incidents
Environment=HOME=/var/lib/jp-incidents
Environment=JPI_DB=/opt/jp-incidents/jp_incidents.db
Environment=PYTHONUNBUFFERED=1
Environment="GIT_SSH_COMMAND=/usr/bin/ssh -oBatchMode=yes -oStrictHostKeyChecking=yes"
EnvironmentFile=-/opt/jp-incidents/.env
ExecStart=/opt/jp-incidents/.venv/bin/python /opt/jp-incidents/jp_incidents.py retry-publication
TimeoutStartSec=3min
UMask=0077
